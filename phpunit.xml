<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="SEED_PASSWORD" value="testing-seed-password"/>
        <!-- Kunci API AI selalu kosong saat testing: AIService memakai fallback
             mock berbasis database sehingga suite tidak pernah memanggil API eksternal. -->
        <env name="AI_API_KEY" value=""/>
        <!-- Pencarian visual: selama suite memakai mesin pengenalan bawaan (gd)
             agar tidak pernah menghubungi layanan Python eksternal; tes integrasi
             YOLO mengaktifkan driver hybrid sendiri lewat Http::fake(). -->
        <env name="IMAGE_SEARCH_DRIVER" value="gd"/>
        <!-- Notifikasi nonaktif & kredensial kosong saat testing: observer notifikasi
             tidak pernah mengirim email/pesan eksternal apa pun selama suite berjalan. -->
        <env name="NOTIFICATIONS_ENABLED" value="false"/>
        <env name="TELEGRAM_BOT_TOKEN" value=""/>
        <env name="TELEGRAM_CHAT_ID" value=""/>
        <env name="TELEGRAM_ADMIN_CHAT_ID" value=""/>
        <env name="WHATSAPP_ACCESS_TOKEN" value=""/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value=""/>
        <env name="WHATSAPP_ADMIN_PHONE" value=""/>
        <!-- Integrasi chatbot (PROMPT 9): isolasi dari .env live. Saklar kanal
             = true agar perilaku tidak berubah dari sebelum gerbang
             WHATSAPP_ENABLED / TELEGRAM_ENABLED ada; kredensial webhook,
             username, dan alias chat id dikosongkan. -->
        <env name="TELEGRAM_ENABLED" value="true"/>
        <env name="TELEGRAM_BOT_USERNAME" value=""/>
        <env name="TELEGRAM_BOT_CHAT_ID" value=""/>
        <env name="TELEGRAM_WEBHOOK_SECRET" value=""/>
        <env name="WHATSAPP_ENABLED" value="true"/>
        <env name="WHATSAPP_VERIFY_TOKEN" value=""/>
        <env name="WHATSAPP_APP_SECRET" value=""/>
        <env name="WHATSAPP_ADMIN_NUMBER" value=""/>
        <env name="NOTIFICATION_ADMIN_EMAIL" value="admin-test@agungatk.test"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
