# =============================================================================
# Cron — Scheduler Agung ATK (pengganti schedule:work; jalankan SATU saja)
# =============================================================================
# Buka: crontab -u www-data -e   (atau via panel hosting: Cron Jobs)
# Baris di bawah menjalankan scheduler Laravel TIAP MENIT.
# Tugas terjadwal sendiri menentukan jam eksekusinya (07:00 WIB, dst.).
# =============================================================================

* * * * * cd /var/www/agungatkopencode && php artisan schedule:run >> /dev/null 2>&1

# -----------------------------------------------------------------------------
# Alternatif (bila panel hosting menyediakan "task scheduler harian"):
#   0 7 * * *  cd /var/www/agungatkopencode && php artisan notifications:daily-summary >> storage/logs/scheduler.log 2>&1
#   0 2 * * *  cd /var/www/agungatkopencode && php artisan queue:prune-failed --hours=720 >> storage/logs/scheduler.log 2>&1
#   15 2 * * * cd /var/www/agungatkopencode && php artisan queue:prune-batches --hours=720 >> storage/logs/scheduler.log 2>&1
# -----------------------------------------------------------------------------
# Catatan zona waktu: jadwal aplikasi memakai Asia/Jakarta. Pastikan TZ server
# dan jadwal cron disesuaikan agar 07:00 WIB benar-benar jam 07:00.
# Jika server UTC: 07:00 WIB = 00:00 UTC (jadwal di aplikasi sudah mengonversi).
