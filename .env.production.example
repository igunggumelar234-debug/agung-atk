# =============================================================================
# Template environment PRODUKSI — Agung ATK
# =============================================================================
# Pemakaian di VPS:
#   cp .env.production.example .env
#   php artisan key:generate --force        # isi APP_KEY
#   lalu isi SEMUA nilai placeholder di bawah (kredensial hanya di .env).
#
# ATURAN:
#   - JANGAN pernah meng-commit .env berisi nilai nyata.
#   - APP_URL & WEBHOOK_PUBLIC_URL wajib HTTPS domain resmi (tanpa localhost).
#   - APP_DEBUG=false di produksi (jangan tampilkan detail exception).
# =============================================================================

APP_NAME="Agung ATK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Domain resmi HTTPS — dipakai route() saat mode konsol/queue.
APP_URL=https://domain-anda.example
# Root HTTPS untuk URL webhook yang didaftarkan ke Fonnte/Meta/Telegram.
WEBHOOK_PUBLIC_URL=https://domain-anda.example

TZ=Asia/Jakarta

# Password akun hasil SEEDER — kosongkan; akun produksi dibuat via pendaftaran
# atau migrasi. JANGAN menjalankan seeder data dev di produksi.
SEED_PASSWORD=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log harian; level info di produksi (bukan debug).
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# --- Database (MySQL sesuai spesifikasi aplikasi) ----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agung_atk
DB_USERNAME=agung_atk_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie sesi hanya dikirim via HTTPS (wajib bila seluruh trafik HTTPS).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# --- Gmail (pengiriman email nyata — opsional) --------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=akun-anda@gmail.com
# MAIL_PASSWORD=<app-password-16-karakter>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=akun-anda@gmail.com

VITE_APP_NAME="${APP_NAME}"

# API AI Assistant (kosongkan = mode fallback lokal berbasis database)
AI_API_KEY=
AI_URL=
AI_MODEL=
AI_TIMEOUT=

# Pencarian Visual — 'gd' = mesin bawaan (tanpa layanan Python);
# 'hybrid' = YOLO dulu bila ai-service/server.py dijalankan, fallback otomatis.
IMAGE_SEARCH_DRIVER=gd
IMAGE_SEARCH_SERVICE_URL=http://127.0.0.1:8090
IMAGE_SEARCH_SERVICE_TIMEOUT=10
IMAGE_SEARCH_SERVICE_CONNECT_TIMEOUT=2
IMAGE_SEARCH_YOLO_MIN_CONFIDENCE=0.80
IMAGE_SEARCH_YOLO_MIN_MARGIN=0.00

# --- Notifikasi otomatis ------------------------------------------------------
NOTIFICATIONS_ENABLED=true
# Mode mock: false = kirim sungguhan ke penyedia luar.
NOTIFICATIONS_MOCK=false
# true = kirim lewat antrean (systemd agung-atk-worker aktif).
NOTIFICATIONS_QUEUE=true
NOTIFICATION_ADMIN_EMAIL=admin@contoh.com
# Nomor WhatsApp admin (format 628xxx) untuk notifikasi via Fonnte.
WHATSAPP_ADMIN_PHONE=628xxxxxxxxxx

# Telegram (opsional) — token dari @BotFather; chat id dari getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp: provider Fonnte (utama) ----------------------------------------
WHATSAPP_PROVIDER=fonnte
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_NUMBER=628xxxxxxxxxx
# Cadangan Meta Cloud API (opsional — hanya bila WHATSAPP_PROVIDER=meta).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_DEFAULT_COUNTRY_CODE=62
WHATSAPP_MESSAGE_MODE=text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Fonnte (https://docs.fonnte.com/) — API token dari dashboard Fonnte.
FONNTE_API_URL=https://api.fonnte.com
FONNTE_API_TOKEN=
FONNTE_TIMEOUT=15
# Secret PATH webhook Fonnte — bila kosong seluruh webhook ditolak (403).
# Wajib diisi agar notifikasi masuk dari Fonnte diterima aplikasi.
FONNTE_WEBHOOK_SECRET=
