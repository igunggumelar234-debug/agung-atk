APP_NAME="Agung ATK"
APP_ENV=local
APP_KEY=
# local: true | PRODUKSI: false (jangan pernah menampilkan detail pengecualian ke pengguna)
APP_DEBUG=true # pengembangan; di produksi WAJIB false
APP_URL=http://localhost:8000

# Zona waktu bisnis (WIB). Menentukan tanggal dashboard & filter laporan harian.
TZ=Asia/Jakarta

# Password untuk akun development hasil seeder (JANGAN diisi nilai rahasia di repository)
SEED_PASSWORD=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Log rotasi harian (file laravel.log dipotong otomatis, retensi LOG_DAILY_DAYS).
# PRODUKSI: LOG_LEVEL=info
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Database ---------------------------------------------------------------
# Development (default): SQLite
DB_CONNECTION=sqlite
# DB_DATABASE=

# Produksi (MySQL/MariaDB) — hapus tanda # pada baris di bawah:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=agung_atk
# DB_USERNAME=agung_atk_user
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# --- Gmail (pengiriman email nyata) -----------------------------------------
# Aktifkan dengan App Password Google (bukan password akun biasa):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=akun-anda@gmail.com
#   MAIL_PASSWORD=<app-password-16-karakter>
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS=akun-anda@gmail.com
#   MAIL_FROM_NAME="Agung ATK"
# Tanpa MAIL_PASSWORD, status email di dashboard jujur: "Belum lengkap".

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API AI Assistant (kosongkan = mode fallback/mock berbasis database; JANGAN isi nilai rahasia di repository)
AI_API_KEY=
AI_URL=
AI_MODEL=
AI_TIMEOUT=

# Pencarian Visual — deteksi objek YOLOv8 (layanan Python terpisah, lihat ai-service/README.md)
# IMAGE_SEARCH_DRIVER  : hybrid = YOLO dulu, otomatis fallback ke pengenalan bawaan saat layanan mati
#                        gd     = hanya mesin pengenalan bawaan (tanpa layanan Python)
IMAGE_SEARCH_DRIVER=hybrid
# URL POST /detect layanan ai-service/server.py (kosongkan = nonaktifkan panggilan YOLO)
IMAGE_SEARCH_SERVICE_URL=http://127.0.0.1:8090
# Timeout total / koneksi (detik) ke layanan deteksi
IMAGE_SEARCH_SERVICE_TIMEOUT=10
IMAGE_SEARCH_SERVICE_CONNECT_TIMEOUT=2
# Ambang keyakinan & margin YOLO — angka default mengikuti hasil sweep
# ai-service/models/metrics.json (conf 0.80 → atk_precision 0.9065 @ coverage 0.8487)
IMAGE_SEARCH_YOLO_MIN_CONFIDENCE=0.80
IMAGE_SEARCH_YOLO_MIN_MARGIN=0.00

# Notifikasi Otomatis (Telegram / WhatsApp / Email) — JANGAN isi nilai rahasia ke repository
NOTIFICATIONS_ENABLED=true
# Mode mock: true = tidak memanggil API luar (pengiriman dicatat saja, untuk demo/pengujian)
NOTIFICATIONS_MOCK=false
# true = kirim lewat antrean (butuh php artisan queue:work); false = langsung
NOTIFICATIONS_QUEUE=true
# Penerima notifikasi admin (GANTI dengan kontak Anda sendiri; JANGAN isi kontak asli di repository)
NOTIFICATION_ADMIN_EMAIL=admin@contoh.com
WHATSAPP_ADMIN_PHONE=628xxxxxxxxxx

# Telegram Bot API — token dari @BotFather. Chat ID DIDAPATKAN dari getUpdates,
# bukan dari nomor telepon (panduan ada di menu Notifikasi admin).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
# WHATSAPP_PROVIDER: provider pengiriman WhatsApp — 'fonnte' (utama) atau 'meta'
# (Cloud API cadangan). Lihat blok FONNTE di bawah.
WHATSAPP_PROVIDER=fonnte
# WHATSAPP_ACCESS_TOKEN: token Graph API Meta (bentuk: EAA...). WHATSAPP_API_KEY
# didukung sebagai alias bila konfigurasi Anda menyebutnya "API Key".
# PENTING: API Key BUKAN WHATSAPP_PHONE_NUMBER_ID — keduanya kredensial berbeda;
# Phone Number ID diambil dari Meta App Dashboard -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
# Nama resmi Meta; bila diisi, mendahului WHATSAPP_API_VERSION di atas.
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_DEFAULT_COUNTRY_CODE=62
# 'text' = pesan teks bebas; 'template' = template yang sudah disetujui Meta
WHATSAPP_MESSAGE_MODE=text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
# --- Integrasi chatbot (webhook masuk & saklar kanal) ---
# WHATSAPP_ENABLED / TELEGRAM_ENABLED: saklar integrasi per kanal (default aman: false).
# WHATSAPP_VERIFY_TOKEN: token verifikasi webhook GET dari Meta Business Suite.
# WHATSAPP_APP_SECRET: app secret Meta untuk validasi X-Hub-Signature-256 (disarankan).
# WHATSAPP_ADMIN_NUMBER: nomor tujuan notifikasi admin (alternatif WHATSAPP_ADMIN_PHONE).
# TELEGRAM_BOT_USERNAME: username bot tanpa '@' dari BotFather (BUKAN token).
# TELEGRAM_BOT_CHAT_ID: alias TELEGRAM_CHAT_ID (nilai lama tetap didukung).
# TELEGRAM_WEBHOOK_SECRET: secret_token untuk header X-Telegram-Bot-Api-Secret-Token.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_NUMBER=628xxxxxxxxxx

# Fonnte WhatsApp Gateway (https://docs.fonnte.com/) — provider WhatsApp utama.
# FONNTE_API_TOKEN: API token dari dashboard Fonnte (Profile -> Token/API key).
# Simpan HANYA di .env — jangan pernah menaruhnya di repository atau tampilan.
FONNTE_API_URL=https://api.fonnte.com
FONNTE_API_TOKEN=
FONNTE_TIMEOUT=15
TELEGRAM_ENABLED=false
# Username bot hasil BotFather (tanpa '@') — BUKAN token.
TELEGRAM_BOT_USERNAME=AGUNGATK_bot
TELEGRAM_BOT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=id


# --- Checklist Produksi (hapus tanda # saat go-live) ------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tokoanda.example
# SESSION_SECURE_COOKIE=true          # aktifkan bila seluruh trafik HTTPS
# LOG_LEVEL=info
# NOTIFICATIONS_MOCK=false
# MAIL_MAILER=smtp                    # isi MAIL_HOST/PORT/USERNAME/PASSWORD & MAIL_FROM_ADDRESS
